  "machine_acceptance": [
    {
      "id": "exact-natural-path",
      "criterion": "首次状态从能力简报开始，学习者不跳转内部状态即可依次到达本地决策回执。"
    },
    {
      "id": "synthetic-and-governance-labeling",
      "criterion": "每个状态都可见合成模拟标记，并明确结果不构成真实雇佣或绩效结论。"
    },
    {
      "id": "evidence-before-decision",
      "criterion": "前四图合成证据和目标能力要求在任何决策输入之前出现。"
    },
    {
      "id": "roles-and-constraints-before-decision",
      "criterion": "未确认本人模拟角色、四个团队角色及时间、范围、隐私约束时，不能进入决策状态。"
    },
    {
      "id": "verifiable-decision-input",
      "criterion": "回执只能在学习者选择一个处置方案、引用至少一条能力证据和一项约束、并输入不少于 20 个字符的理由后生成。"
    },
    {
      "id": "fact-advice-choice-separation",
      "criterion": "回执分别标记合成事实、AI建议、人类选择和系统状态，不输出准备度评分或真实人才结论。"
    },
    {
      "id": "three-viewport-continuity",
      "criterion": "390、768、1280 CSS 像素宽度下无水平溢出、隐藏主操作或内容重叠。"
    },
    {
      "id": "interaction-and-recovery",
      "criterion": "键盘、触控尺寸、减少动态、校验错误、状态切换和页面重进均保留清晰的唯一下一操作，且无控制台错误。"
    }
  ],
  "human_acceptance": [
    {
      "id": "orientation-and-safety",
      "criterion": "首次体验者无需讲解，能说明这是合成大型项目演练、当前要做的事以及结果不能用于真实人才决定。",
      "threshold": "3/3 目标学习者，进入后 20 秒内"
    },
    {
      "id": "evidence-to-decision-traceability",
      "criterion": "体验者能指出自己的决定引用了哪条前置证据和哪项项目约束。",
      "threshold": "3/3 目标学习者，不经提示"
    },
    {
      "id": "role-and-constraint-comprehension",
      "criterion": "体验者能说出本人模拟角色、至少两个协作角色和全部三项硬约束。",
      "threshold": "3/3 目标学习者，不经提示"
    },
    {
      "id": "clarity-and-willingness",
      "criterion": "体验者评价决策任务清晰度和继续完成副本的意愿。",
      "threshold": "两项中位数均不低于 4/5，且 0 次引导救援"
    }
  ],
