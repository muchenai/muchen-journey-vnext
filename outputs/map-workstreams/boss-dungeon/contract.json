        "meaningful_action": "读取四条明确标记为合成模拟的前四图能力证据和三项目标能力要求。"
      },
      {
        "id": "safe-scenario-confirmation",
        "meaningful_action": "确认场景、公司、客户、人员和评估均为合成模拟，且结果不用于真实雇佣、晋升、淘汰、薪酬或绩效决定。"
      },
      {
        "id": "team-and-constraints-confirmation",
        "meaningful_action": "确认四个模拟团队角色、本人承担的角色，以及时间、范围、隐私三项约束。"
      },
      {
        "id": "first-verifiable-decision",
        "meaningful_action": "选择处置方案，引用至少一条能力证据和一项项目约束，并写出决策理由。"
      },
      {
        "id": "local-decision-receipt-visible",
        "meaningful_action": "查看仅存于浏览器本地会话的合成决策回执，其中合成事实、AI建议、人类选择和系统状态彼此分离。"
      }
    ]
  },
  "scenario": {
    "id": "synthetic-harbor-recovery-01",
    "label": "合成模拟 · 港湾计划恢复演练",
    "purpose": "练习在范围、时间和隐私约束下做出可解释的项目判断。",
