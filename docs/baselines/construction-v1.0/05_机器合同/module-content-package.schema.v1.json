{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muchen.local/schemas/module-content-package.v1.json",
  "title": "Muchen Journey Module Content Package V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "module_key", "version", "owner", "source_refs", "effective_at", "content_items", "task_versions", "rubrics", "reviewer_policy", "data_policy", "sha256"],
  "properties": {
    "schema_version": {"const": "module-content-package.v1"},
    "package_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$"},
    "module_key": {"enum": ["exploration-camp", "newcomer-village", "ai-academy", "delivery-guild"]},
    "version": {"type": "string", "minLength": 1, "maxLength": 40},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "person_name", "signed_at", "decision"],
      "properties": {
        "role": {"enum": ["exploration_camp_owner", "newcomer_village_owner", "ai_academy_owner", "delivery_guild_owner"]},
        "person_name": {"type": "string", "minLength": 2, "maxLength": 120},
        "signed_at": {"type": "string", "format": "date-time"},
        "decision": {"const": "APPROVED"}
      }
    },
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[A-Z]+-[0-9]{2}$"}},
    "effective_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "content_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content_id", "title", "version", "source_ref", "owner", "estimated_minutes", "visibility", "data_classification", "sha256"],
        "properties": {
          "content_id": {"type": "string", "minLength": 3, "maxLength": 120},
          "title": {"type": "string", "minLength": 2, "maxLength": 180},
          "version": {"type": "string", "minLength": 1, "maxLength": 40},
          "source_ref": {"type": "string", "minLength": 3, "maxLength": 300},
          "owner": {"type": "string", "minLength": 2, "maxLength": 120},
          "estimated_minutes": {"type": "integer", "minimum": 1, "maximum": 480},
          "visibility": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["LEARNER", "REVIEWER", "OPERATOR"]}},
          "data_classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL_PEOPLE"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "task_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_key", "version", "purpose", "non_goals", "inputs", "deliverables", "rubric_id", "reviewer_pool_ref", "help_path", "execution_environment", "retention_policy", "sha256"],
        "properties": {
          "task_key": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,79}$"},
          "version": {"type": "string", "minLength": 1, "maxLength": 40},
          "purpose": {"type": "string", "minLength": 10, "maxLength": 1000},
          "non_goals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3, "maxLength": 300}},
          "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2, "maxLength": 300}},
          "deliverables": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2, "maxLength": 300}},
          "rubric_id": {"type": "string", "minLength": 3, "maxLength": 120},
          "reviewer_pool_ref": {"type": "string", "minLength": 3, "maxLength": 120},
          "help_path": {"type": "string", "minLength": 3, "maxLength": 300},
          "execution_environment": {"enum": ["SIMULATION", "CONTROLLED_REAL_TASK"]},
          "controlled_task_authorization_ref": {"type": ["string", "null"], "minLength": 3, "maxLength": 300},
          "retention_policy": {"type": "string", "minLength": 3, "maxLength": 120},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "allOf": [
          {
            "if": {"properties": {"execution_environment": {"const": "CONTROLLED_REAL_TASK"}}},
            "then": {"required": ["controlled_task_authorization_ref"], "properties": {"controlled_task_authorization_ref": {"type": "string"}}}
          }
        ]
      }
    },
    "rubrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rubric_id", "version", "dimensions", "human_decision_required", "calibration_evidence_ref", "sha256"],
        "properties": {
          "rubric_id": {"type": "string", "minLength": 3, "maxLength": 120},
          "version": {"type": "string", "minLength": 1, "maxLength": 40},
          "dimensions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2, "maxLength": 120}},
          "human_decision_required": {"const": true},
          "calibration_evidence_ref": {"type": "string", "minLength": 3, "maxLength": 300},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "reviewer_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pool_ref", "primary_reviewers", "backup_reviewers", "first_response_sla_minutes", "completion_sla_minutes", "escalation_owner"],
      "properties": {
        "pool_ref": {"type": "string", "minLength": 3, "maxLength": 120},
        "primary_reviewers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 120}},
        "backup_reviewers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 120}},
        "first_response_sla_minutes": {"type": "integer", "minimum": 1},
        "completion_sla_minutes": {"type": "integer", "minimum": 1},
        "escalation_owner": {"type": "string", "minLength": 2, "maxLength": 120}
      }
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_write_allowed", "raw_customer_data_allowed", "ai_high_impact_decision_allowed", "visibility", "retention_policy"],
      "properties": {
        "production_write_allowed": {"const": false},
        "raw_customer_data_allowed": {"const": false},
        "ai_high_impact_decision_allowed": {"const": false},
        "visibility": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["PERSON", "ASSIGNED_REVIEWERS", "AUTHORIZED_OPERATORS"]}},
        "retention_policy": {"type": "string", "minLength": 3, "maxLength": 120}
      }
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

