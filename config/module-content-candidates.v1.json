      ],
      "tasks": [
        {
          "task_key": "EXP-P1",
          "title": "规则拆解",
          "purpose": "把一段工作规则拆成可执行、可提报且不会越过红线的判断结构。",
          "non_goals": [
            "背诵规则原文",
            "自行补写未知规则",
            "仅输出总分或结论"
          ],
          "inputs": [
            "获批的短规则或合成规则材料"
          ],
          "deliverables": [
            "目标",
            "判断维度",
            "红线",
            "例外",
            "不确定项",
            "需提报问题"
          ],
          "estimated_minutes": 30,
          "execution_environment": "SIMULATION",
          "rubric": {
            "rubric_id": "EXP-P1-R1",
            "dimensions": [
              "目标识别准确",
              "判断维度完整",
              "红线与不可做事项明确",
              "例外和不确定项分开",
              "提报对象和问题具体"
            ],
            "pass_rule": "五个维度至少四项满足，且红线识别不得失败；真人Reviewer必须写理由。",
            "revision_rule": "缺少必交字段、把猜测写成事实、遗漏安全红线或提报对象不明确时返工。",
            "human_decision_required": true
          },
          "reward_policy": {
            "points_after_human_pass": 10,
            "repeat_award_allowed": false,
            "talent_conclusion_effect": "NONE"
          }
        },
        {
          "task_key": "EXP-P2",
          "title": "模型回答判断",
          "purpose": "对同一Prompt的两个回答作出可解释判断，并保留无法判断和不确定性的空间。",
          "non_goals": [
            "凭个人偏好选答案",
            "把AI建议当作真人结论",
            "编造外部事实"
          ],
          "inputs": [
            "同一Prompt的A/B回答",
            "获批评价上下文"
          ],
          "deliverables": [
            "选择A、选择B或无法判断",
            "判断维度",
            "具体理由",
            "证据与对比",
            "不确定项"
          ],
          "estimated_minutes": 35,
          "execution_environment": "SIMULATION",
          "rubric": {
            "rubric_id": "EXP-P2-R1",
            "dimensions": [
              "事实和证据",
              "回答完整性",
              "指令遵循",
              "对比理由具体",
              "不确定性披露"
            ],
            "pass_rule": "至少覆盖最相关的三个维度，理由必须引用回答中的具体证据，且不得编造事实。",
            "revision_rule": "只有结论无证据、理由泛化、忽略关键指令或隐藏不确定性时返工。",
            "human_decision_required": true
          },
          "reward_policy": {
            "points_after_human_pass": 10,
            "repeat_award_allowed": false,
            "talent_conclusion_effect": "NONE"
          }
        },
        {
          "task_key": "EXP-P3",
          "title": "边界与问题提报",
          "purpose": "在数据、规则或协作异常中先控制风险，再把问题提报给正确的人。",
          "non_goals": [
            "未经授权继续执行",
            "把未知项当作事实",
            "越权替决策人下结论"
          ],
          "inputs": [
            "合成的数据、规则或协作异常情境"
          ],
          "deliverables": [
            "已知事实",
            "未知项",
            "潜在影响",
            "安全的临时处理建议",
            "停止线",
            "需谁裁决"
          ],
          "estimated_minutes": 30,
          "execution_environment": "SIMULATION",
          "rubric": {
            "rubric_id": "EXP-P3-R1",
            "dimensions": [
              "事实与未知项分离",
              "影响判断",
              "停止线",
              "临时处理不扩大风险",
              "裁决人和问题具体"
            ],
            "pass_rule": "停止线和安全临时处理两项必须满足，其余三个维度至少两项满足；真人Reviewer必须写理由。",
            "revision_rule": "继续执行高风险动作、未区分事实和猜测、无停止线或无裁决对象时返工。",
            "human_decision_required": true
          },
          "reward_policy": {
            "points_after_human_pass": 10,
            "repeat_award_allowed": false,
            "talent_conclusion_effect": "NONE"
          }
        }
